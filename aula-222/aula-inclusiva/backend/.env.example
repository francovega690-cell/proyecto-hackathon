JWT_SECRET=
PORT=3005
DB_NAME=aula_inclusiva
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_DIALECT=mysql
DB_PORT=3306
# En la nube: podés usar una sola URL en vez de las DB_* sueltas
# DATABASE_URL=mysql://usuario:clave@host:3306/aula_inclusiva
# La mayoría de los MySQL en la nube exigen SSL
DB_SSL=false

# Solo en desarrollo: true BORRA y recrea todas las tablas al arrancar
DB_RESET=false

# Orígenes permitidos por CORS, separados por coma (la URL del frontend).
# Si el backend sirve el frontend (despliegue en un solo servicio) no hace falta cambiarlo.
CLIENT_ORIGIN=http://localhost:5173

# true solo si frontend y backend están en dominios distintos (ej: Vercel + Render).
# Requiere HTTPS.
COOKIE_CROSS_SITE=false

# Opcional: si lo completás, cada publicación nueva se manda a este webhook
# de n8n para que la IA la adapte. Si lo dejás vacío, se usa una adaptación
# local automática (no rompe nada).
N8N_WEBHOOK_URL=
